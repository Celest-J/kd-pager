# /etc/kd-pager/hub.env  (root:kdpager 0640). Every line is required unless marked optional.
KDPAGER_SB_URL=https://nxukkhyjasusqbzhkqdv.supabase.co
KDPAGER_ANON_KEY=<KD anon key, public, from the site bundle>
KDPAGER_FCM_PROJECT=<your Firebase project id>
KDPAGER_LISTEN=127.0.0.1:9440
KDPAGER_DATA_DIR=/var/lib/kd-pager
KDPAGER_KEY_SOURCE=gcp-secret
KDPAGER_KEY_SECRET=projects/<PROJECT>/secrets/<NAME>/versions/latest
# Local dev only (replaces the two gcp lines above):
#   KDPAGER_KEY_SOURCE=env-dev
#   KDPAGER_DEV_KEY_HEX=<64 hex chars>
# Optional overrides of fixed production endpoints (leave unset in prod):
#   KDPAGER_SITE_URL  KDPAGER_FCM_URL  KDPAGER_METADATA_URL  KDPAGER_SECRETMANAGER_URL
